# Copy this file to .env and replace the example password before starting Compose.
SUBMANAGER_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
SQLSERVER_DATABASE=SubManager
SQLSERVER_EDITION=Express
# SQL Server requires at least 8 characters using 3 of these 4 groups: uppercase, lowercase, numbers, and symbols.
SQLSERVER_SA_PASSWORD=ChangeThis_Example123!

# Optional: public DNS name used by the commented Caddy HTTPS service in compose.yaml.
# SUBMANAGER_DOMAIN=submanager.example.com
