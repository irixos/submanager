@page "/login"
@layout LoginLayout
@implements IDisposable
@using SubManager.ApiClient
@using SubManager.Client.Authentication
@inject IdentityClient IdentityClient
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<EditForm EditContext="editContext" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5">SubManager</MudText>
            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
            }
            <MudTextField Label="Email" Class="mt-3"
                          @bind-Value="loginRequest.Email" For="@(() => loginRequest.Email)" />
            <MudTextField Label="Password" Class="mt-3" InputType="InputType.Password"
                          @bind-Value="loginRequest.Password" For="@(() => loginRequest.Password)" />
        </MudCardContent>
        <MudCardActions>
            <MudSpacer />
            @if (isLoadingSetup)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else if (canRegister is null)
            {
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadSetupStatus">
                    Retry
                </MudButton>
            }
            else if (canRegister.Value)
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="isSubmitting">
                    @(isSubmitting ? "Please wait" : "Register")
                </MudButton>
            }
            else
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Login" Disabled="isSubmitting">
                    @(isSubmitting ? "Please wait" : "Login")
                </MudButton>
            }
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private readonly LoginRequest loginRequest = new();
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private EditContext editContext = default!;
    private string? errorMessage;
    private bool? canRegister;
    private bool isLoadingSetup = true;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(loginRequest);

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/feed", replace: true);
            return;
        }

        await LoadSetupStatus();
    }

    private Task HandleSubmit() => Submit(register: canRegister == true);

    private async Task LoadSetupStatus()
    {
        isLoadingSetup = true;
        canRegister = null;
        errorMessage = null;

        try
        {
            var status = await IdentityClient.SetupStatusAsync(cancellationTokenSource.Token);
            canRegister = status.CanRegister;
        }
        catch (ApiException)
        {
            errorMessage = "Unable to determine whether registration is available.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
        finally
        {
            isLoadingSetup = false;
        }
    }

    private async Task Submit(bool register)
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            if (register)
            {
                await IdentityClient.RegisterAsync(new RegisterRequest
                {
                    Email = loginRequest.Email,
                    Password = loginRequest.Password
                }, cancellationTokenSource.Token);
            }

            await LoginWithCookies();
            await AuthenticationStateProvider.RefreshAsync();
            NavigationManager.NavigateTo("/feed", replace: true);
        }
        catch (ApiException<HttpValidationProblemDetails> exception)
        {
            errorMessage = exception.Result.Errors is null
                ? exception.Result.Title ?? "Unable to register."
                : string.Join(" ", exception.Result.Errors.Values.SelectMany(messages => messages));
        }
        catch (ApiException exception)
        {
            if (register && exception.StatusCode == 409)
            {
                canRegister = false;
                errorMessage = "An account already exists. Log in instead.";
            }
            else
            {
                errorMessage = exception.StatusCode == 401
                    ? "Invalid email or password."
                    : register ? "Unable to register." : "Unable to log in.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoginWithCookies()
    {
        try
        {
            await IdentityClient.LoginAsync(true, false, loginRequest, cancellationTokenSource.Token);
        }
        catch (ApiException exception) when (exception.StatusCode == 200)
        {
            // Cookie login returns an empty 200 response, while the generated client expects a token body.
        }
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
