@page "/forgot-password"
@layout LoginLayout
@implements IAsyncDisposable
@using SubManager.ApiClient
@inject IdentityClient IdentityClient

<PageTitle>Forgot password</PageTitle>

<MudCard>
    <MudCardContent>
        <MudText Typo="Typo.h5">Reset password</MudText>
        @if (isLoading)
        {
            <MudProgressCircular Class="mt-4" Indeterminate="true" />
        }
        else if (error is not null && !canSendEmail)
        {
            <MudAlert Class="mt-4" Severity="Severity.Error">@error</MudAlert>
        }
        else if (!canSendEmail)
        {
            <MudAlert Class="mt-4" Severity="Severity.Warning">
                Password recovery is unavailable until SMTP is configured by the server administrator.
            </MudAlert>
        }
        else if (isComplete)
        {
            <MudAlert Class="mt-4" Severity="Severity.Success">
                Your password has been reset. You can now sign in with the new password.
            </MudAlert>
        }
        else if (!codeRequested)
        {
            <MudForm @ref="requestForm" @bind-IsValid="isRequestValid" OnEnterPressed="RequestCode" Class="mt-4">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body2">Enter your login email and we'll send a one-time reset code.</MudText>
                    <MudTextField @bind-Value="email"
                                  Label="Email"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="Enter your email"
                                  Validation="@((Func<string, string?>)ValidateEmail)"
                                  AutoFocus="true" />
                    @if (error is not null)
                    {
                        <MudAlert Severity="Severity.Error">@error</MudAlert>
                    }
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="RequestCode"
                               Disabled="@(!isRequestValid || isSubmitting)">
                        @(isSubmitting ? "Sending…" : "Send reset code")
                    </MudButton>
                </MudStack>
            </MudForm>
        }
        else
        {
            <MudStack Spacing="3" Class="mt-4">
                <MudAlert Severity="Severity.Info">
                    If an account exists for that email, a reset code has been sent.
                </MudAlert>
                <MudForm @ref="resetForm" @bind-IsValid="isResetValid" OnEnterPressed="ResetPassword">
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="resetCode"
                                      Label="Reset code"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="Enter the reset code"
                                      AutoFocus="true" />
                        <MudTextField @bind-Value="newPassword"
                                      Label="New password"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="Enter a new password"
                                      Validation="@((Func<string, string?>)ValidateNewPassword)" />
                        <MudTextField @bind-Value="confirmedPassword"
                                      Label="Confirm new password"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="Confirm your new password"
                                      Validation="@((Func<string, string?>)ValidateConfirmation)" />
                        @if (error is not null)
                        {
                            <MudAlert Severity="Severity.Error">@error</MudAlert>
                        }
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   OnClick="ResetPassword"
                                   Disabled="@(!isResetValid || isSubmitting)">
                            @(isSubmitting ? "Resetting…" : "Reset password")
                        </MudButton>
                    </MudStack>
                </MudForm>
            </MudStack>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Href="login" Variant="Variant.Text">Back to login</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private MudForm? requestForm;
    private MudForm? resetForm;
    private string email = string.Empty;
    private string resetCode = string.Empty;
    private string newPassword = string.Empty;
    private string confirmedPassword = string.Empty;
    private string? error;
    private bool isLoading = true;
    private bool canSendEmail;
    private bool codeRequested;
    private bool isComplete;
    private bool isRequestValid;
    private bool isResetValid;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            canSendEmail = (await IdentityClient.SetupStatusAsync(cancellationTokenSource.Token)).CanSendEmail;
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (ApiException)
        {
            error = "Unable to check password recovery availability.";
        }
        catch (HttpRequestException)
        {
            error = "Unable to reach the server.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string? ValidateEmail(string? value) =>
        new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(value)
            ? null
            : "Enter a valid email address";

    private string? ValidateConfirmation(string? value) =>
        value == newPassword ? null : "Passwords do not match";

    private static string? ValidateNewPassword(string? value) =>
        value?.Length >= 6 ? null : "Password must be at least 6 characters";

    private async Task RequestCode()
    {
        await requestForm!.ValidateAsync();
        if (!isRequestValid || isSubmitting)
            return;

        isSubmitting = true;
        error = null;

        try
        {
            await IdentityClient.ForgotPasswordAsync(new ForgotPasswordRequest
            {
                Email = email.Trim()
            }, cancellationTokenSource.Token);
            codeRequested = true;
        }
        catch (ApiException)
        {
            error = "Unable to request a reset code. Please try again.";
        }
        catch (HttpRequestException)
        {
            error = "Unable to reach the server.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ResetPassword()
    {
        await resetForm!.ValidateAsync();
        if (!isResetValid || isSubmitting)
            return;

        isSubmitting = true;
        error = null;

        try
        {
            await IdentityClient.ResetPasswordAsync(new ResetPasswordRequest
            {
                Email = email.Trim(),
                ResetCode = resetCode.Trim(),
                NewPassword = newPassword
            }, cancellationTokenSource.Token);
            isComplete = true;
        }
        catch (ApiException<HttpValidationProblemDetails> exception)
        {
            error = exception.Result.Errors is null
                ? "Unable to reset the password."
                : string.Join(" ", exception.Result.Errors.Values.SelectMany(messages => messages));
        }
        catch (ApiException)
        {
            error = "Unable to reset the password. Please check the code and try again.";
        }
        catch (HttpRequestException)
        {
            error = "Unable to reach the server.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await cancellationTokenSource.CancelAsync();
        cancellationTokenSource.Dispose();
    }
}
