@page "/subscriptions"
@attribute [Authorize]
@using SubManager.ApiClient
@inject ChannelsClient ChannelsClient
@inject CategoriesClient CategoriesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Subscriptions</PageTitle>

<MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
    <MudTooltip Text="Import subscriptions">
        <MudIconButton Icon="@Icons.Material.Filled.UploadFile"
                       OnClick="ImportChannels"
                       aria-label="Import subscriptions" />
    </MudTooltip>
</MudStack>

@if (!hasLoaded && isLoading)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (loadError is not null && channels.Count == 0)
{
    <ErrorAlert OnRetry="FetchChannels">
        Unable to load channels.
    </ErrorAlert>
}
else if (hasLoaded && channels.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Subscriptions" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h6">No subscriptions yet</MudText>
            <MudText Align="Align.Center">Press the + button to add a channel, or import a subscriptions file.</MudText>
            <MudButton StartIcon="@Icons.Material.Filled.UploadFile"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="ImportChannels">
                Import subscriptions
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <InfiniteScroll ItemCount="channels.Count"
                    HasMore="hasMoreChannels && loadError is null"
                    IsLoading="isLoading"
                    LoadMore="FetchChannels">
        <MudList T="string">
            @foreach (var channel in channels)
            {
                <MudListItem @key="channel.Id" OnClick="@(() => EditChannel(channel))">
                    <AvatarContent>
                        <MudAvatar>
                            <img src="@channel.ThumbnailUrl" alt="@channel.Name" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover;" />
                        </MudAvatar>
                    </AvatarContent>
                    <ChildContent>
                        @channel.Name
                    </ChildContent>
                </MudListItem>
            }
        </MudList>

        @if (isLoading)
        {
            <MudProgressCircular Class="mt-4" Color="Color.Default" Indeterminate="true" />
        }

        @if (loadError is not null)
        {
            <ErrorAlert Class="mt-4" OnRetry="FetchChannels">
                Unable to load more channels.
            </ErrorAlert>
        }
    </InfiniteScroll>
}

<MudFab StartIcon="@Icons.Material.Filled.Add"
        Color="Color.Primary"
        OnClick="AddChannel"
        class="subscriptions-fab"
        aria-label="Add channel" />

@code {
    private readonly List<ChannelResponse> channels = [];
    private readonly List<CategoryResponse> categories = [];
    private const int PageSize = 20;
    private int currentPage = 1;
    private bool isLoading;
    private bool hasLoaded;
    private bool hasMoreChannels = true;
    private Exception? loadError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(FetchChannels(), FetchCategories());
    }

    private async Task FetchCategories()
    {
        categories.Clear();
        const int pageSize = 100;
        var page = 1;

        while (true)
        {
            var categoryPage = await CategoriesClient.GetCategoriesAsync(page, pageSize, "Name, Id", null);
            var newCategories = categoryPage.Data?.ToList() ?? [];
            categories.AddRange(newCategories);

            if (newCategories.Count < pageSize ||
                categoryPage.Count.HasValue && categories.Count >= categoryPage.Count.Value)
                return;

            page++;
        }
    }

    private async Task AddChannel()
    {
        var parameters = new DialogParameters<AddChannelDialog>
        {
            { dialog => dialog.Categories, categories }
        };
        var dialog = await DialogService.ShowAsync<AddChannelDialog>("Add channel", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await RefreshPage();
    }

    private async Task EditChannel(ChannelResponse channel)
    {
        var parameters = new DialogParameters<EditChannelDialog>
        {
            { dialog => dialog.Channel, channel },
            { dialog => dialog.Categories, categories }
        };
        var dialog = await DialogService.ShowAsync<EditChannelDialog>("Channel", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await RefreshPage();
    }

    private async Task ImportChannels()
    {
        var dialog = await DialogService.ShowAsync<ImportChannelsDialog>("Import subscriptions",
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var response = await dialog.GetReturnValueAsync<ImportChannelsResponse>();
        if (response is null)
            return;

        Snackbar.Add(
            $"Imported {response.ImportedCount.GetValueOrDefault()}, " +
            $"skipped {response.DuplicateCount.GetValueOrDefault()} duplicates, " +
            $"and failed {response.FailedCount.GetValueOrDefault()}.",
            response.FailedCount.GetValueOrDefault() > 0 ? Severity.Warning : Severity.Success);
        await RefreshPage();
    }

    private async Task RefreshPage()
    {
        channels.Clear();
        currentPage = 1;
        hasMoreChannels = true;
        hasLoaded = false;
        await Task.WhenAll(FetchChannels(), FetchCategories());
    }

    private async Task FetchChannels()
    {
        if (isLoading || !hasMoreChannels)
            return;

        isLoading = true;
        loadError = null;

        try
        {
            var channelPage = await ChannelsClient.GetChannelsAsync(
                currentPage, PageSize, "Name, Id", null);

            var newChannels = channelPage.Data?.ToList() ?? [];
            channels.AddRange(newChannels);
            currentPage++;

            hasMoreChannels = newChannels.Count > 0 &&
                (channelPage.Count.HasValue
                    ? channels.Count < channelPage.Count.Value
                    : newChannels.Count == PageSize);
        }
        catch (Exception exception)
        {
            loadError = exception;
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
        }
    }
}
