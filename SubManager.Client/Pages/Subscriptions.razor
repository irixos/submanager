@page "/subscriptions"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.RegularExpressions
@using SubManager.ApiClient
@inject ChannelsClient ChannelsClient
@inject CategoriesClient CategoriesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Subscriptions</PageTitle>

<SubscriptionToolbar Categories="categories"
                     SearchText="@searchText"
                     SearchTextChanged="SearchChanged"
                     SelectedCategoryIds="selectedCategoryIds"
                     SelectedCategoryIdsChanged="CategoriesChanged"
                     ImportRequested="ImportChannels"
                     AddCategoryRequested="AddCategory"
                     ManageCategoriesRequested="ManageCategories"
                     ShowCategories="showCategories"
                     ShowCategoriesChanged="@((bool value) => showCategories = value)"
                     ClearRequested="ClearFilters" />

@if (categoryLoadError is not null)
{
    <ErrorAlert Class="mb-3" OnRetry="RefreshCategoryState">
        Unable to load categories.
    </ErrorAlert>
}

@if (!hasLoaded && isLoading)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (loadError is not null && channels.Count == 0)
{
    <ErrorAlert OnRetry="FetchChannels">
        Unable to load channels.
    </ErrorAlert>
}
else if (hasLoaded && channels.Count == 0 && HasFilters)
{
    <MudPaper Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
            <MudText Typo="Typo.h6">No subscriptions match</MudText>
            <MudText Align="Align.Center">Try another name or category selection.</MudText>
            <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear filters</MudButton>
        </MudStack>
    </MudPaper>
}
else if (hasLoaded && channels.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Subscriptions" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h6">No subscriptions yet</MudText>
            <MudText Align="Align.Center">Press the + button to add a channel, or import a subscriptions file.</MudText>
            <MudButton StartIcon="@Icons.Material.Filled.UploadFile"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="ImportChannels">
                Import subscriptions
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <InfiniteScroll ItemCount="channels.Count"
                    HasMore="hasMoreChannels && loadError is null"
                    IsLoading="isLoading"
                    LoadMore="FetchChannels">
        <MudList T="string">
            @foreach (var channel in channels)
            {
                <SubscriptionListItem @key="channel.Id"
                                      Channel="channel"
                                      ShowCategories="showCategories"
                                      Selected="EditChannel" />
            }
        </MudList>

        @if (isLoading)
        {
            <MudProgressCircular Class="mt-4" Color="Color.Default" Indeterminate="true" />
        }

        @if (loadError is not null)
        {
            <ErrorAlert Class="mt-4" OnRetry="FetchChannels">
                Unable to load more channels.
            </ErrorAlert>
        }
    </InfiniteScroll>
}

<div class="subscriptions-fab">
    <MudFab StartIcon="@Icons.Material.Filled.Add"
            Color="Color.Primary"
            OnClick="AddChannel"
            aria-label="Add channel" />
</div>

@code {
    private const int PageSize = 20;
    private readonly List<ChannelResponse> channels = [];
    private readonly List<CategoryResponse> categories = [];
    private readonly CancellationTokenSource lifetimeCancellationTokenSource = new();
    private CancellationTokenSource loadCancellationTokenSource = new();
    private IReadOnlyCollection<int> selectedCategoryIds = [];
    private string searchText = string.Empty;
    private int currentPage = 1;
    private bool isLoading;
    private bool hasLoaded;
    private bool hasMoreChannels = true;
    private bool showCategories;
    private Exception? loadError;
    private Exception? categoryLoadError;

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(searchText) || selectedCategoryIds.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(FetchChannels(), FetchCategories());
    }

    private async Task FetchCategories()
    {
        categoryLoadError = null;
        var loadedCategories = new List<CategoryResponse>();
        const int pageSize = 100;
        var page = 1;

        try
        {
            while (true)
            {
                var categoryPage = await CategoriesClient.GetCategoriesAsync(
                    page, pageSize, "Name, Id", null, lifetimeCancellationTokenSource.Token);
                var newCategories = categoryPage.Data?.ToList() ?? [];
                loadedCategories.AddRange(newCategories);

                if (newCategories.Count < pageSize ||
                    categoryPage.Count.HasValue && loadedCategories.Count >= categoryPage.Count.Value)
                    break;

                page++;
            }

            categories.Clear();
            categories.AddRange(loadedCategories);
        }
        catch (OperationCanceledException) when (lifetimeCancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            categoryLoadError = exception;
        }
    }

    private async Task AddChannel()
    {
        var parameters = new DialogParameters<AddChannelDialog>
        {
            { dialog => dialog.Categories, categories }
        };
        var dialog = await DialogService.ShowAsync<AddChannelDialog>("Add channel", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await RefreshPage();
    }

    private async Task AddCategory()
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { dialog => dialog.UsedColors, categories.Select(category => category.Color).OfType<string>().ToArray() }
        };
        var dialog = await DialogService.ShowAsync<CategoryDialog>("Add category", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var category = await dialog.GetReturnValueAsync<CategoryResponse>();
        if (category is not null)
            await RefreshCategoryState();
    }

    private async Task ManageCategories()
    {
        var parameters = new DialogParameters<ManageCategoriesDialog>
        {
            { dialog => dialog.Categories, categories }
        };
        var dialog = await DialogService.ShowAsync<ManageCategoriesDialog>("Manage categories", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await RefreshCategoryState();
    }

    private async Task EditChannel(ChannelResponse channel)
    {
        var parameters = new DialogParameters<EditChannelDialog>
        {
            { dialog => dialog.Channel, channel },
            { dialog => dialog.Categories, categories }
        };
        var dialog = await DialogService.ShowAsync<EditChannelDialog>("Channel", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await RefreshPage();
    }

    private async Task ImportChannels()
    {
        var dialog = await DialogService.ShowAsync<ImportChannelsDialog>("Import subscriptions",
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var response = await dialog.GetReturnValueAsync<ImportChannelsResponse>();
        if (response is null)
            return;

        Snackbar.Add(
            $"Imported {response.ImportedCount.GetValueOrDefault()}, " +
            $"skipped {response.DuplicateCount.GetValueOrDefault()} duplicates, " +
            $"and failed {response.FailedCount.GetValueOrDefault()}.",
            response.FailedCount.GetValueOrDefault() > 0 ? Severity.Warning : Severity.Success);
        await RefreshPage();
    }

    private async Task RefreshPage()
    {
        await Task.WhenAll(RefreshChannels(), FetchCategories());
    }

    private async Task RefreshCategoryState()
    {
        await FetchCategories();
        if (categoryLoadError is not null)
            return;

        var validCategoryIds = categories
            .Select(category => category.Id.GetValueOrDefault())
            .ToHashSet();
        selectedCategoryIds = selectedCategoryIds
            .Where(validCategoryIds.Contains)
            .ToArray();
        await RefreshChannels();
    }

    private async Task RefreshChannels()
    {
        await loadCancellationTokenSource.CancelAsync();
        loadCancellationTokenSource.Dispose();
        loadCancellationTokenSource = new CancellationTokenSource();

        channels.Clear();
        currentPage = 1;
        hasMoreChannels = true;
        hasLoaded = false;
        isLoading = false;
        await FetchChannels();
    }

    private async Task FetchChannels()
    {
        if (isLoading || !hasMoreChannels)
            return;

        var cancellationToken = loadCancellationTokenSource.Token;
        isLoading = true;
        loadError = null;

        try
        {
            var channelPage = await ChannelsClient.GetChannelsAsync(
                currentPage, PageSize, "Name, Id", BuildFilter(), cancellationToken);

            if (cancellationToken != loadCancellationTokenSource.Token)
                return;

            var newChannels = channelPage.Data?.ToList() ?? [];
            channels.AddRange(newChannels);
            currentPage++;

            hasMoreChannels = newChannels.Count > 0 &&
                (channelPage.Count.HasValue
                    ? channels.Count < channelPage.Count.Value
                    : newChannels.Count == PageSize);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            loadError = exception;
        }
        finally
        {
            if (cancellationToken == loadCancellationTokenSource.Token)
            {
                isLoading = false;
                hasLoaded = true;
            }
        }
    }

    private string? BuildFilter()
    {
        var filters = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchText))
            filters.Add($"Name=*{EscapeGridifyValue(searchText.Trim())}/i");

        filters.AddRange(selectedCategoryIds.Select(categoryId => $"Categories.Id={categoryId}"));
        return filters.Count == 0 ? null : string.Join(',', filters);
    }

    private static string EscapeGridifyValue(string value)
    {
        return Regex.Replace(value, "([(),|\\\\])", "\\$1")
            .Replace("/i", "\\/i", StringComparison.OrdinalIgnoreCase);
    }

    private async Task SearchChanged(string value)
    {
        searchText = value;
        await RefreshChannels();
    }

    private async Task CategoriesChanged(IReadOnlyCollection<int> categoryIds)
    {
        selectedCategoryIds = categoryIds;
        await RefreshChannels();
    }

    private async Task ClearFilters()
    {
        searchText = string.Empty;
        selectedCategoryIds = [];
        await RefreshChannels();
    }

    public async ValueTask DisposeAsync()
    {
        await lifetimeCancellationTokenSource.CancelAsync();
        await loadCancellationTokenSource.CancelAsync();

        lifetimeCancellationTokenSource.Dispose();
        loadCancellationTokenSource.Dispose();
    }
}
