@page "/feed"
@attribute [Authorize]
@using SubManager.ApiClient
@using Humanizer
@inject VideosClient VideosClient

<PageTitle>Feed</PageTitle>

@if (!hasLoaded && isLoading)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (loadError is not null && videos.Count == 0)
{
    <MudAlert Severity="Severity.Error">
        Unable to load videos.
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="FetchVideos">Retry</MudButton>
    </MudAlert>
}
else if (hasLoaded && videos.Count == 0)
{
    <MudAlert Severity="Severity.Info">No videos found</MudAlert>
}
else
{
    <InfiniteScroll ItemCount="videos.Count"
                    HasMore="hasMoreVideos && loadError is null"
                    IsLoading="isLoading"
                    LoadMore="FetchVideos">
        <MudGrid>
            @foreach (var video in videos)
            {
                <MudItem @key="video.Id" xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardMedia Image="@video.ThumbnailUrl"/>
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
                                <MudAvatar>
                                    <img src="@video.Channel?.ThumbnailUrl" alt="@video.Channel?.Name" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover;"/>
                                </MudAvatar>
                                <MudStack>
                                    <MudText><strong>@video.Title</strong></MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
                                        <MudText>@video.Channel?.Name</MudText>
                                        <MudText>@video.ViewCount?.ToMetric(decimals: 0)</MudText>
                                        <MudText>@video.PublishedDate?.Humanize()</MudText>
                                    </MudStack>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        @if (isLoading)
        {
            <MudProgressCircular Class="mt-4" Color="Color.Default" Indeterminate="true" />
        }

        @if (loadError is not null)
        {
            <MudAlert Class="mt-4" Severity="Severity.Error">
                Unable to load more videos.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="FetchVideos">Retry</MudButton>
            </MudAlert>
        }
    </InfiniteScroll>
}

@code {
    private readonly List<VideoResponse> videos = [];
    private const int PageSize = 20;
    private int currentPage = 1;
    private bool isLoading;
    private bool hasLoaded;
    private bool hasMoreVideos = true;
    private Exception? loadError;

    protected override async Task OnInitializedAsync()
    {
        await FetchVideos();
    }

    private async Task FetchVideos()
    {
        if (isLoading || !hasMoreVideos)
            return;

        isLoading = true;
        loadError = null;

        try
        {
            var videoPage = await VideosClient.GetVideosAsync(
                currentPage, PageSize, "PublishedDate desc, Id desc", "IsShort = false");

            var newVideos = videoPage.Data?.ToList() ?? [];
            videos.AddRange(newVideos);
            currentPage++;

            hasMoreVideos = newVideos.Count > 0 &&
                (videoPage.Count.HasValue
                    ? videos.Count < videoPage.Count.Value
                    : newVideos.Count == PageSize);
        }
        catch (Exception exception)
        {
            loadError = exception;
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
        }
    }
}
