@page "/feed"
@attribute [Authorize]
@implements IAsyncDisposable
@using SubManager.ApiClient
@inject VideosClient VideosClient
@inject ChannelsClient ChannelsClient
@inject CategoriesClient CategoriesClient
@inject IJSRuntime JS
@inject ILogger<Feed> Logger
@inject ISnackbar Snackbar

<PageTitle>Feed</PageTitle>

<div @ref="pullRefreshElement" class="pull-refresh" aria-hidden="true">
    <div class="pull-refresh-indicator">
        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
        <span>Pull to refresh</span>
    </div>
</div>

<FeedToolbar Categories="categories"
             Channels="channels"
             @bind-SelectedCategoryIds="selectedCategoryIds"
             @bind-SelectedCategoryIds:after="ReloadVideos"
             @bind-SelectedChannelIds="selectedChannelIds"
             @bind-SelectedChannelIds:after="ReloadVideos"
             @bind-SearchText="searchText"
             @bind-SearchText:after="ReloadVideos"
             @bind-IsGrid="isGrid"
             @bind-IsGrid:after="PersistViewMode"
             ReloadRequested="RefreshFeed"
             IsRefreshing="isRefreshing"
             @bind-ShowCategories="showCategories"
             @bind-ShowCategories:after="PersistShowCategories"
             ClearRequested="ClearFilters" />

@if (filterOptionsError is not null)
{
    <ErrorAlert Class="mb-3" OnRetry="LoadFilterOptions">
        Unable to load feed filters.
    </ErrorAlert>
}

@if (!hasLoaded && isLoading)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (loadError is not null && videos.Count == 0)
{
    <ErrorAlert OnRetry="FetchVideos">
        Unable to load videos.
    </ErrorAlert>
}
else if (hasLoaded && videos.Count == 0 && HasFilters)
{
    <MudPaper Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
            <MudText Typo="Typo.h6">No videos match</MudText>
            <MudText Align="Align.Center">Try another title, category, or channel selection.</MudText>
            <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear filters</MudButton>
        </MudStack>
    </MudPaper>
}
else if (hasLoaded && videos.Count == 0)
{
    <MudAlert Severity="Severity.Info">No videos found</MudAlert>
}
else
{
    <InfiniteScroll ItemCount="videos.Count"
                    HasMore="hasMoreVideos && loadError is null"
                    IsLoading="isLoading"
                    LoadMore="FetchVideos">
        <div class="video-feed @(isGrid ? "video-feed-grid" : "video-feed-list")">
            @foreach (var video in videos)
            {
                <VideoFeedItem @key="video.Id"
                               Video="video"
                               IsGrid="isGrid"
                               Opened="MarkWatched"
                               RestoreRequested="RestoreUnwatched"
                               ShowCategories="showCategories"
                               IsDurationPending="durationMetadataActive && video.DurationSeconds is null"
                               IsUpdatingWatchedState="watchedUpdates.Contains(video.Id.GetValueOrDefault())" />
            }
        </div>

        @if (isLoading)
        {
            <MudProgressCircular Class="mt-4" Color="Color.Default" Indeterminate="true" />
        }

        @if (loadError is not null)
        {
            <ErrorAlert Class="mt-4" OnRetry="FetchVideos">
                Unable to load more videos.
            </ErrorAlert>
        }
    </InfiniteScroll>
}
