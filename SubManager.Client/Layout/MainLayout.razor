@inherits LayoutComponentBase
@implements IAsyncDisposable
@using SubManager.ApiClient
@using SubManager.Client.Authentication
@inject IdentityClient IdentityClient
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject AppThemeState ThemeState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudThemeProvider Theme="ThemeState.Theme" IsDarkMode="ThemeState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
                <MudText Typo="Typo.h6" Class="ml-2">@PageName</MudText>
                <MudSpacer />
                <MudIconButton Icon="@ThemeState.Icon" Color="Color.Inherit" OnClick="ThemeState.Toggle" />
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout" Disabled="_isLoggingOut">Logout</MudMenuItem>
                </MudMenu>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                <NavMenu />
            </MudDrawer>

            <MudMainContent Class="px-4 pb-4">
                @Body
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    private bool _isLoggingOut;
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        NavigationManager.LocationChanged += OnLocationChanged;

    }

    private string PageName
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
                .Split('?', '#')[0]
                .Trim('/');

            if (path.Length == 0)
                return "Feed";

            var segment = Uri.UnescapeDataString(path.Split('/')[^1]).Replace('-', ' ');
            return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(segment);
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    public ValueTask DisposeAsync()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task Logout()
    {
        if (_isLoggingOut)
            return;

        _isLoggingOut = true;
        try
        {
            try
            {
                await IdentityClient.LogoutAsync(_cancellationTokenSource.Token);
            }
            catch (ApiException exception) when (exception.StatusCode == 401)
            {
                // The session has already expired.
            }

            AuthenticationStateProvider.MarkAnonymous();
            NavigationManager.NavigateTo("/login", replace: true);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (ApiException)
        {
            Snackbar.Add("Unable to log out. Please try again.", Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

}
