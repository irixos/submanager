@using SubManager.ApiClient

<MudChipSet T="int"
            SelectionMode="SelectionMode.MultiSelection"
            SelectedValues="selectedIds"
            SelectedValuesChanged="OnSelectedValuesChanged"
            Disabled="Disabled"
            Class="category-chip-set">
    @foreach (var category in Categories)
    {
        <MudChip T="int"
                 @key="category.Id"
                 Value="category.Id.GetValueOrDefault()"
                 Style="@GetChipStyle(category)"
                 Label="true">
            @category.Name
        </MudChip>
    }

    @if (AllowCreate)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Size="Size.Small"
                       Disabled="Disabled"
                       OnClick="AddRequested"
                       aria-label="Add category" />
    }
</MudChipSet>

@code {
    private IReadOnlyCollection<int> selectedIds = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<CategoryResponse> Categories { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<int> SelectedIds { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyCollection<int>> SelectedIdsChanged { get; set; }

    [Parameter]
    public EventCallback AddRequested { get; set; }

    [Parameter]
    public bool AllowCreate { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    protected override void OnParametersSet()
    {
        selectedIds = SelectedIds.ToArray();
    }

    private async Task OnSelectedValuesChanged(IReadOnlyCollection<int> values)
    {
        selectedIds = values;
        await SelectedIdsChanged.InvokeAsync(values);
    }

    private string GetChipStyle(CategoryResponse category)
    {
        var color = NormalizeColor(category.Color);
        if (!selectedIds.Contains(category.Id.GetValueOrDefault()))
            return $"background-color: {color}26; color: {color}99; border-color: {color}66;";

        return $"background-color: {color}; color: {GetForeground(color)}; border-color: {color};";
    }

    private static string NormalizeColor(string? color)
    {
        return color is { Length: 7 } && color[0] == '#'
            ? color
            : "#757575";
    }

    private static string GetForeground(string color)
    {
        var red = Convert.ToInt32(color.Substring(1, 2), 16);
        var green = Convert.ToInt32(color.Substring(3, 2), 16);
        var blue = Convert.ToInt32(color.Substring(5, 2), 16);
        var luminance = (red * 299 + green * 587 + blue * 114) / 1000;
        return luminance >= 150 ? "#1A1A1A" : "#FFFFFF";
    }
}
