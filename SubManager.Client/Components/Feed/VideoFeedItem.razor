@using Humanizer
@using SubManager.ApiClient

<article class="video-feed-item @(IsGrid ? "video-feed-grid-item" : "video-feed-list-item")">
    <div class="video-thumbnail-container">
        <a class="video-thumbnail-link"
           href="@VideoUrl"
           target="_blank"
           rel="noopener noreferrer"
           @onclick="@(() => Opened.InvokeAsync(Video))"
           aria-label="@($"Watch {Video.Title}")">
            <img src="@Video.ThumbnailUrl"
                 alt=""
                 referrerpolicy="no-referrer"
                 class="video-thumbnail @(Video.IsWatched is true ? "video-thumbnail-watched" : null)" />
            @if (Video.DurationSeconds.HasValue)
            {
                <span class="video-duration">@FormatDuration(Video.DurationSeconds.Value)</span>
            }
            else if (IsDurationPending)
            {
                <span class="video-duration-loading" aria-hidden="true">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" />
                </span>
            }
        </a>
        @if (Video.IsWatched is true)
        {
            <div class="restore-watched">
                <MudTooltip Text="Mark as unwatched">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Inherit"
                                   Size="Size.Small"
                                   Disabled="IsUpdatingWatchedState"
                                   OnClick="@(() => RestoreRequested.InvokeAsync(Video))"
                                   aria-label="Mark as unwatched" />
                </MudTooltip>
            </div>
        }
    </div>

    <div class="video-details">
        @if (IsGrid)
        {
            <a class="channel-avatar-link"
               href="@ChannelUrl"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="@($"Open {Video.Channel?.Name}")">
                <MudAvatar Size="Size.Medium">
                    <img src="@Video.Channel?.ThumbnailUrl"
                         alt=""
                         referrerpolicy="no-referrer"
                         class="channel-thumbnail" />
                </MudAvatar>
            </a>
        }

        <div class="video-text">
            <a class="video-title"
               href="@VideoUrl"
               target="_blank"
               rel="noopener noreferrer"
               @onclick="@(() => Opened.InvokeAsync(Video))">
                @Video.Title
            </a>
            <a class="channel-name-link"
               href="@ChannelUrl"
               target="_blank"
               rel="noopener noreferrer">
                @Video.Channel?.Name
            </a>
            <div class="video-metadata">
                @if (Video.ViewCount.HasValue)
                {
                    <span>@Video.ViewCount.Value.ToMetric(decimals: 0) views</span>
                }
                @if (Video.PublishedDate.HasValue)
                {
                    <span>@Video.PublishedDate.Value.Humanize()</span>
                }
            </div>
            @if (ShowCategories)
            {
                <CategorySummary Categories="Video.Categories?.ToArray() ?? []" />
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public VideoResponse Video { get; set; } = null!;

    [Parameter]
    public bool IsGrid { get; set; }

    [Parameter]
    public EventCallback<VideoResponse> Opened { get; set; }

    [Parameter]
    public EventCallback<VideoResponse> RestoreRequested { get; set; }

    [Parameter]
    public bool IsUpdatingWatchedState { get; set; }

    [Parameter]
    public bool IsDurationPending { get; set; }

    [Parameter]
    public bool ShowCategories { get; set; }

    private string VideoUrl =>
        $"https://www.youtube.com/watch?v={Uri.EscapeDataString(Video.YoutubeVideoId ?? string.Empty)}";

    private string ChannelUrl =>
        $"https://www.youtube.com/channel/{Uri.EscapeDataString(Video.Channel?.YoutubeChannelId ?? string.Empty)}";

    private static string FormatDuration(int totalSeconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(0, totalSeconds));
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}"
            : $"{duration.Minutes}:{duration.Seconds:00}";
    }
}
