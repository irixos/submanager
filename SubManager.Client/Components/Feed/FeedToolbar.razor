@using SubManager.ApiClient

<PageToolbar>
    <Actions>
        @if (HasActiveFilters)
        {
            <MudButton Size="Size.Small" OnClick="ClearRequested">Clear filters</MudButton>
        }
        <MudTooltip Text="Search videos">
            <MudIconButton Icon="@Icons.Material.Filled.Search"
                           Color="@(showSearch || !string.IsNullOrWhiteSpace(SearchText) ? Color.Primary : Color.Default)"
                           OnClick="ToggleSearch"
                           aria-label="Search videos" />
        </MudTooltip>
        <MudTooltip Text="Filter videos">
            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                           Color="@(showFilters || HasActiveFilters ? Color.Primary : Color.Default)"
                           OnClick="ToggleFilters"
                           aria-label="Filter videos" />
        </MudTooltip>
        @if (IsRefreshing)
        {
            <div class="feed-refresh-progress" role="status" aria-label="Refreshing feed">
                <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <MudTooltip Text="Refresh feed">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="ReloadRequested"
                               aria-label="Refresh feed" />
            </MudTooltip>
        }
        <ViewModeToggle IsGrid="IsGrid"
                        IsGridChanged="IsGridChanged" />
        <MudTooltip Text="Category display">
            <MudMenu Icon="@Icons.Material.Filled.Label"
                     AriaLabel="Category display"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@(ShowCategories ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                             OnClick="@(() => ShowCategoriesChanged.InvokeAsync(!ShowCategories))">
                    Show categories on videos
                </MudMenuItem>
            </MudMenu>
        </MudTooltip>
    </Actions>
    <ExpandedContent>
        @if (showSearch)
        {
            <MudTextField T="string"
                          Value="SearchText"
                          ValueChanged="SearchTextChanged"
                          Label="Video title"
                          Placeholder="Search videos"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          DebounceInterval="300"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AutoFocus="true" />
        }

        @if (showFilters)
        {
            <MudText Typo="Typo.subtitle2">Categories</MudText>
            @if (Categories.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No categories available.</MudText>
            }
            else
            {
                <CategoryChipSet Categories="Categories"
                                 SelectedIds="SelectedCategoryIds"
                                 SelectedIdsChanged="SelectedCategoryIdsChanged" />
            }

            <MudText Typo="Typo.subtitle2">Channels</MudText>
            @if (Channels.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No channels available.</MudText>
            }
            else
            {
                <div class="channel-filter-menu">
                    <MudMenu Label="@ChannelFilterLabel"
                             Variant="Variant.Outlined"
                             FullWidth="true"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown"
                             RelativeWidth="DropdownWidth.Adaptive"
                             OpenChanged="OnChannelMenuOpenChanged">
                        <div class="channel-filter-search"
                             @onclick:stopPropagation="true"
                             @onkeydown:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                            <input class="channel-filter-search-input"
                                   value="@channelSearchText"
                                   @oninput="FilterChannels"
                                   placeholder="Search channels"
                                   aria-label="Search channels" />
                        </div>
                        @foreach (var channel in FilteredChannels)
                        {
                            var channelId = channel.Id.GetValueOrDefault();
                            <MudMenuItem @key="channel.Id"
                                         AutoClose="false"
                                         Icon="@(SelectedChannelIds.Contains(channelId)
                                             ? Icons.Material.Filled.CheckBox
                                             : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                         OnClick="@(() => ToggleChannel(channelId))">
                                @channel.Name
                            </MudMenuItem>
                        }
                    </MudMenu>
                </div>
            }
        }
    </ExpandedContent>
</PageToolbar>

@code {
    private string channelSearchText = string.Empty;
    private bool showFilters;
    private bool showSearch;

    [Parameter, EditorRequired]
    public IReadOnlyList<CategoryResponse> Categories { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ChannelResponse> Channels { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<int> SelectedCategoryIds { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyCollection<int>> SelectedCategoryIdsChanged { get; set; }

    [Parameter]
    public IReadOnlyCollection<int> SelectedChannelIds { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyCollection<int>> SelectedChannelIdsChanged { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    [Parameter]
    public bool IsGrid { get; set; }

    [Parameter]
    public EventCallback<bool> IsGridChanged { get; set; }

    [Parameter]
    public EventCallback ReloadRequested { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public bool ShowCategories { get; set; }

    [Parameter]
    public EventCallback<bool> ShowCategoriesChanged { get; set; }

    [Parameter]
    public EventCallback ClearRequested { get; set; }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchText) ||
        SelectedCategoryIds.Count > 0 ||
        SelectedChannelIds.Count > 0;

    private IEnumerable<ChannelResponse> FilteredChannels =>
        string.IsNullOrWhiteSpace(channelSearchText)
            ? Channels
            : Channels.Where(channel =>
                channel.Name?.Contains(channelSearchText, StringComparison.OrdinalIgnoreCase) is true);

    private void ToggleFilters()
    {
        showFilters = !showFilters;
        if (!showFilters)
            channelSearchText = string.Empty;
    }

    private void ToggleSearch() => showSearch = !showSearch;

    private string ChannelFilterLabel =>
        SelectedChannelIds.Count == 0
            ? "Channels"
            : string.Join(", ", SelectedChannelIds.Select(id => GetChannelName(id) ?? id.ToString()));

    private void FilterChannels(ChangeEventArgs args) =>
        channelSearchText = args.Value?.ToString() ?? string.Empty;

    private void OnChannelMenuOpenChanged(bool open)
    {
        if (!open)
            channelSearchText = string.Empty;
    }

    private Task ToggleChannel(int id)
    {
        var values = SelectedChannelIds.ToHashSet();
        if (!values.Add(id))
            values.Remove(id);

        return SelectedChannelIdsChanged.InvokeAsync(values.ToArray());
    }

    private string? GetChannelName(int id) =>
        Channels.FirstOrDefault(channel => channel.Id == id)?.Name;
}
